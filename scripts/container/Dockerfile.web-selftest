# Web-driver-selftest container for agent-factory (#1592 Phase 5 PR6).
#
# The browser harness needs THREE toolchains in one image that the plain testbox
# image (Dockerfile.test) deliberately does NOT carry: Go (to build af + run the
# daemon), Node (to run Playwright), and a real Chromium with all its system deps.
# Rather than bloat the shared testbox image that every other gate uses, this is a
# dedicated image built only for `make web-selftest-container`.
#
# Base: the official Playwright image, which pins Node + a Chromium build + every
# libnss/libgbm/font system dep the browser needs. Pinned to v1.56.1-noble to match
# the @playwright/test version locked in web/package-lock.json, so the bundled
# browser revision matches the npm package the harness runs.
#
# Toolchain-only, like Dockerfile.test: the source is bind-mounted read-only at run
# time (scripts/testbox.sh), so this image rebuilds only when the toolchain changes,
# never on code changes. Its build context is two files that testbox.sh assembles:
# this Dockerfile and scripts/ci-apt-install.sh. By hand, the scripts/ directory
# works as the context:
#
#     docker build -f scripts/container/Dockerfile.web-selftest scripts
FROM mcr.microsoft.com/playwright:v1.56.1-noble

# Every apt install below goes through scripts/ci-apt-install.sh (#7096), the
# wrapper the workflows use (#3774). This base ships a NodeSource apt source
# (/etc/apt/sources.list.d/nodesource.list, from Playwright's own Dockerfile) that
# this image never installs from. A bare `apt-get update && apt-get install`
# fails the build whenever ANY source fails, so a NodeSource 403 or an expired
# signature would fail the build. With the wrapper the update is advisory and the
# install is the assertion: a broken source we do not use is printed and
# survived, and a package that is genuinely unavailable still fails the build.
#
# APT_ATTEMPT_TIMEOUT: the wrapper times out each apt-get call (180s by default)
# and retries a timed-out one, which suits a runner adding one small package.
# The ffmpeg layer below pulls a few hundred packages, and a call killed while
# dpkg is unpacking can leave the next attempt a half-configured system. 900s
# still lets a slow mirror finish. An ARG reaches these RUNs and stays out of
# the image's runtime environment.
COPY ci-apt-install.sh /usr/local/lib/agent-factory/ci-apt-install.sh
ARG APT_ATTEMPT_TIMEOUT=900

# tmux + git are what the daemon drives to run sessions; procps provides pgrep for
# the daemon's SIGTERM fallback path — the same trio Dockerfile.test installs.
RUN bash /usr/local/lib/agent-factory/ci-apt-install.sh tmux git procps ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Go 1.25 (the repo floor, CLAUDE.md). Fetched from the official tarball for the
# build arch so the image is not tied to a distro Go package. GO_SHA256 pins the
# amd64 tarball; arm64 builds skip the checksum (dev box + CI are amd64).
ARG GO_VERSION=1.25.0
ARG GO_SHA256=2852af0cb20a13139b3448992e69b868e50ed0f8a1e5940ee1de9e19a123b613
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
        amd64) goarch=amd64 ;; \
        arm64) goarch=arm64 ;; \
        *) echo "unsupported arch: $arch" >&2; exit 1 ;; \
    esac; \
    url="https://go.dev/dl/go${GO_VERSION}.linux-${goarch}.tar.gz"; \
    curl -fsSL "$url" -o /tmp/go.tgz; \
    if [ "$goarch" = amd64 ]; then echo "${GO_SHA256}  /tmp/go.tgz" | sha256sum -c -; fi; \
    tar -C /usr/local -xzf /tmp/go.tgz; \
    rm /tmp/go.tgz

# Stable git identity so no mock-repo commit depends on host git config leaking in
# (mirrors Dockerfile.test), and mark the read-only /src bind mount safe so the Go
# toolchain / git never refuse it as "dubious ownership" (#1167).
RUN git config --system user.name "AF Web Selftest" \
    && git config --system user.email "web-selftest@localhost" \
    && git config --system init.defaultBranch master \
    && git config --system --add safe.directory /src \
    && git config --system --add safe.directory /work

# Go on PATH; module/build caches under /work (the writable copy the entry makes),
# so a warm bind-mounted cache volume can speed repeat runs. TERM mirrors an
# interactive box (the fake agent runs under tmux). PLAYWRIGHT_BROWSERS_PATH is set
# by the base image to the bundled browser location — left as-is.
ENV PATH=/usr/local/go/bin:/root/go/bin:$PATH \
    TERM=xterm-256color \
    GOMODCACHE=/cache/gomod \
    GOCACHE=/cache/gobuild

# ffmpeg, for the demo recorder only (#3855, scripts/container/web-demo-entry.sh
# / `make demo-assets`). Playwright writes a VP8 webm; docs/ ships an mp4, a
# smaller webm, a GIF fallback and a poster, and the conversion has to happen
# where the recording happens — the host is a shared box and this repo does not
# ask maintainers to install a media toolchain to update a README.
#
# It is a SEPARATE, LAST layer on purpose: appended to the apt line above it
# would invalidate the Go tarball download for every web-selftest build, and the
# gate runs far more often than the recorder does. The gate itself never invokes
# ffmpeg — this only makes the image able to.
RUN bash /usr/local/lib/agent-factory/ci-apt-install.sh ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
