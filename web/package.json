{
  "name": "af-web",
  "version": "0.0.0",
  "private": true,
  "description": "Agent Factory browser web client (#1592 Phase 5) — a second thin client of the daemon's REST+WS API. PR1 ships only the wire-frame codec + toolchain; UI lands in PR2+.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "icons": "node gen-icons.mjs",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "selftest": "playwright test"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/common": "1.5.3",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.7.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "22.10.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "esbuild": "^0.25.10",
    "lucide": "1.25.0",
    "tsx": "^4.20.6",
    "typescript": "5.7.2"
  }
}
